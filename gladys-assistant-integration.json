  "name": "CDC Respiratory Viruses",
  "description": {
    "en": "Flu, COVID-19 and RSV in your US state or county: CDC wastewater and hospital levels.",
    "fr": "Grippe, COVID-19 et VRS dans votre État ou comté américain : eaux usées et hôpitaux (CDC).",
    "de": "Grippe, COVID-19 und RSV in deinem US-Bundesstaat oder County: Abwasser und Kliniken (CDC).",
    "es": "Gripe, COVID-19 y VRS en su estado o condado de EE. UU.: aguas residuales y hospitales (CDC)."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-cdc-respiratory:1.0.0",
  "gladys_version": ">=5.3.0",
